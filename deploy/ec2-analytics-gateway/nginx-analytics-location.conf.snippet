# ADDITIVE snippet for /etc/nginx/sites-enabled/bevvi-mcp.conf
# Do not replace the existing server block. Insert inside the TLS server { } for mcp.getbevvi.com.
#
# Prerequisite: analytics gateway listens on loopback only (example port 8791 — verify with ss -lntp).

    location = /analytics {
        proxy_pass http://127.0.0.1:8791/analytics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /analytics/health {
        proxy_pass http://127.0.0.1:8791/analytics/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
