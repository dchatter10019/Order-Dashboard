# Bevvi retailer fee / commission rules (markdown). Server reads this at runtime — no redeploy to update fees.
# Default: docs/Bevvi-Invoicing-Rules.md next to server.js
# Use an absolute path on production, or a path relative to server.js (not the shell cwd):
# INVOICING_RULES_PATH=/var/www/Order-Dashboard/docs/Bevvi-Invoicing-Rules.md

# Server Configuration
PORT=3001
NODE_ENV=development

# Order dates: IANA timezone for calendar-day boundaries (used when client does not send timeZone, e.g. auto-refresh)
BEVVI_ORDER_TIMEZONE=America/New_York

# API Configuration
BEVVI_API_BASE_URL=https://api.getbevvi.com
BEVVI_API_TIMEOUT=30000

# Slack (optional) — time-based alerts for pending & accepted orders when orders are loaded / auto-refresh.
# New order alerts are dashboard-only (in-app panel); they are not sent to Slack.
# Persisted notified-order keys (shared across browsers on the same machine/server):
# NOTIFIED_ORDERS_PATH=./data/notified-order-keys.json
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Security
SESSION_SECRET=your-session-secret-here
# Dashboard sign-in (required for /api/auth/login — not exposed in the UI)
DASHBOARD_LOGIN_USERNAME=your-dashboard-username
DASHBOARD_LOGIN_PASSWORD=your-long-random-password
# Allowed browser origin for API when frontend is on a different host (e.g. deployed SPA).
# Local dev origins are built-in; add your production frontend URL here if needed.
CORS_ORIGIN=http://localhost:3000
# Production (if SPA and API are on different origins): https://dashboard.getbevvi.com

# If the React app is served separately from server.js (e.g. static hosting), set the full API origin:
# VITE_API_BASE_URL=http://localhost:3001

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
# Required for Manual Order receipt scanning (image/PDF → form fields) and AI prompt parsing

# Web Search (optional, for UPC enrichment)
SERPAPI_API_KEY=your-serpapi-api-key-here

# Stripe (optional, for Manual Order Add payment links after order creation)
# Use your Stripe secret key (sk_test_... or sk_live_...). Creates shareable Payment Links for email.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
# Enable Stripe Tax in the Stripe Dashboard for automatic tax on manual order checkout links.
# Optional overrides for retailer → Stripe Connect account IDs (acct_...).
# By default the server loads connected accounts from Stripe on startup and maps them
# to Bevvi store names using account metadata/business name and store email.
# Total Wine Manual is NOT a connected account — full payment stays on Bevvi.
# STRIPE_STORE_ACCOUNTS_JSON={"Some Retailer":"acct_override123"}
# When a Bevvi store name differs from the Stripe Connect business name, map store → business name (or acct_ id):
# STRIPE_RETAILER_NAME_ALIASES_JSON={"Freshco":"Delancey's Orchard LLC"}
# Saved via Manual Order Add UI → data/stripe-retailer-name-aliases.json (gitignored runtime config)
# When Stripe Tax returns $0 for states where Bevvi still collects tax, fallback rates apply (KY defaults to 6%):
# MANUAL_ORDER_STATE_TAX_FALLBACK_JSON={"KY":0.06,"OH":0.0575}
# Optional redirect URLs after the customer pays or cancels (use {CHECKOUT_SESSION_ID} in success URL)
# STRIPE_PAYMENT_SUCCESS_URL=https://getbevvi.com/?payment=success&session_id={CHECKOUT_SESSION_ID}
# STRIPE_PAYMENT_CANCEL_URL=https://getbevvi.com/?payment=cancelled

# Google Maps (optional, for Manual Order Add address autocomplete/geocoding)
# Enable Places API (New) and Geocoding API on your Google Cloud project.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Asana Configuration
# Get your Asana Personal Access Token from: https://app.asana.com/0/developer-console
ASANA_ACCESS_TOKEN=your-asana-personal-access-token-here
# Get your Workspace GID from Asana API or workspace URL
ASANA_WORKSPACE_GID=your-asana-workspace-gid-here
# Optional: Project GID to add tasks to a specific project
ASANA_PROJECT_GID=your-asana-project-gid-here

# Zoho Books (optional — Retailers tab → Charge Fees / Zoho invoices emailed to retailers)
# Create a Zoho API client (Server-based) with Books scope; generate a refresh token for your org.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_BOOKS_API_BASE=https://www.zohoapis.com/books/v3
# ZOHO_BOOKS_ORG_ID=your_org_id
# ZOHO_CLIENT_ID=your_client_id
# ZOHO_CLIENT_SECRET=your_client_secret
# ZOHO_REFRESH_TOKEN=your_refresh_token
# Invoice copy (ACH only by default — no card payment link unless you opt in)
# ZOHO_INVOICE_PAYMENT_NOTES=Payment by ACH or bank transfer only. Credit card payments are not accepted.
# ZOHO_INVOICE_TERMS=Please remit via ACH. Contact accounts@getbevvi.com for wiring instructions.
# Leave unset or false so Zoho "Pay Now" card links are not expected (also disable cards in Zoho Invoice settings)
# ZOHO_INVOICE_ONLINE_PAYMENT_LINK=false
# Optional: where saved retailer billing emails are stored (default data/retailer-zoho-contacts.json, auto-created from UI prompts)
# RETAILER_ZOHO_CONTACTS_PATH=./data/retailer-zoho-contacts.json

# Analytics dashboard tab (planning forecast). Off unless explicitly enabled.
# BEVVI_ANALYTICS_DASHBOARD_ENABLED=false

# Order Dashboard → analytics gateway MCP (for /api/analytics/*; use cursor-user token or dedicated client)
# BEVVI_ANALYTICS_GATEWAY_URL=https://mcp.getbevvi.com/analytics
# BEVVI_ANALYTICS_GATEWAY_CLIENT_TOKEN=

# Bevvi Analytics Gateway (separate process — see docs/BEVVI_ANALYTICS_GATEWAY.md)
# BEVVI_ANALYTICS_GATEWAY_HOST=127.0.0.1
# BEVVI_ANALYTICS_GATEWAY_PORT=8791
# BEVVI_ANALYTICS_GATEWAY_MODE=mock
# BEVVI_ANALYTICS_GATEWAY_ENABLED=true
# BEVVI_ANALYTICS_GATEWAY_CLIENT_TOKEN=local-dev-only-change-me
# BEVVI_ANALYTICS_GATEWAY_CLIENTS_JSON={"order-dashboard":{"tokenSha256":"<sha256 hex of token>"}}
# BEVVI_ANALYTICS_GATEWAY_OAUTH_STORE_PATH=./data/analytics-gateway/perplexity-oauth-store.json
# BEVVI_ANALYTICS_GATEWAY_SETUP_KEY=long-random-admin-key-for-oauth-routes-only
# Modes: mock | smoke | production (production fails closed if mock flags set)
# BEVVI_ANALYTICS_GATEWAY_SMOKE_ENABLE=false
# BEVVI_ANALYTICS_GATEWAY_PRODUCTION_ENABLE=false
# Live artifact download host allowlist (comma-separated exact host or suffix). Unset = fail closed in production/smoke.
# Do NOT copy example values into production .env without ops approval table sign-off.
# BEVVI_ANALYTICS_GATEWAY_ARTIFACT_DOWNLOAD_ALLOW_HOSTS=example-not-approved.invalid
# One gateway server/scheduler per jobs directory (enforced via OS mutex at startup). Stop server before mutating reconcile CLI.

# Bevvi Analytics MCP (Python — see docs/BEVVI_ANALYTICS_MCP_DEPLOYMENT_APPROVAL.md)
# BEVVI_ANALYTICS_SRC=./vendor/XGBoostForecast
# BEVVI_ANALYTICS_SOURCE_COMMIT=a4e707f7b8d3251677f5cdfcb71d2ead5adf7514
# BEVVI_ANALYTICS_MCP_ROOT=/var/lib/bevvi-analytics-mcp/snapshot/current
# BEVVI_ANALYTICS_MCP_SYNTHETIC=0
# BEVVI_USE_XGBOOST=0
# BEVVI_ANALYTICS_MCP_RESOURCE_URL=https://mcp.getbevvi.com/analytics
# BEVVI_ANALYTICS_MCP_ISSUER_URL=
# BEVVI_ANALYTICS_MCP_JWKS_PATH=
# BEVVI_ANALYTICS_MCP_ALLOWED_SUBJECTS=

# Facebook/Meta API Configuration
# Format: App ID / Page ID / Post ID : Access Token
FACEBOOK_API_IDENTIFIER=2/568120696269174/1212643658293191:5832a006a2cbb8f392dc4fa5b4707e61
